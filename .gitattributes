# Normalize all text files in every directory to LF, so the repo is
# consistent on Windows, Linux, and macOS.
* text=auto eol=lf

# Source code and configuration
*.rs      text eol=lf
*.toml    text eol=lf
*.lock    text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.env     text eol=lf
.env      text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE        text eol=lf

# Documentation
*.md      text eol=lf
*.txt     text eol=lf

# Windows scripts must keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files — never normalize or diff as text
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.exe     binary
*.dll     binary
*.sys     binary
*.bin     binary
*.enc     binary
